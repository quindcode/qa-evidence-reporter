  .qa-rail--fail {
    border-left-color: var(--qa-fail-on-tint);
  }
  .qa-rail--skip {
    border-left-color: var(--qa-skip-on-tint);
  }
  .qa-rail--pending {
    border-left-color: var(--qa-pending-on-tint);
  }

