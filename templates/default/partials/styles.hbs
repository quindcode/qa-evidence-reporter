<style>
  /* ============================================================
     qa-evidence-reporter — CSS embebido (sin <link> externo, ver
     ARCHITECTURE.md "Reporte HTML": el reporte debe abrir con file://
     sin servidor). Tema claro/oscuro vía prefers-color-scheme + un
     toggle que fuerza el tema y lo persiste en localStorage (ver
     partials/theme-script.hbs).

     Los colores de estado (pass/fail/skip/pending) están hardcodeados
     en hex para que coincidan EXACTAMENTE con los del SVG generado en
     src/core/report/charts.ts (RESULT_COLORS) — si se cambia uno, hay
     que cambiar el otro; no hay una única fuente de verdad compartida
     entre TS y CSS porque el CSS no puede importar un módulo TS.
     ============================================================ */
  :root {
    --qa-bg: #ffffff;
    --qa-bg-elevated: #f6f6f7;
    --qa-fg: #1a1a1a;
    --qa-fg-muted: #5f5f5f;
    --qa-border: #dcdcdc;
    --qa-link: #1d4ed8;

    --qa-pass: #15803d;
    --qa-fail: #b91c1c;
    --qa-skip: #57534e;
    --qa-pending: #b45309;

    --qa-pass-bg: #ecfdf3;
    --qa-fail-bg: #fef2f2;
    --qa-skip-bg: #f4f4f5;
    --qa-pending-bg: #fffbeb;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --qa-bg: #17181c;
      --qa-bg-elevated: #202127;
      --qa-fg: #ececec;
      --qa-fg-muted: #a8a8a8;
      --qa-border: #34353b;
      --qa-link: #7aa6ff;

      --qa-pass-bg: #10281b;
      --qa-fail-bg: #2c1414;
      --qa-skip-bg: #26262a;
      --qa-pending-bg: #2b2110;
    }
  }

  /* El toggle (ver theme-script.hbs) estampa data-theme en <html> y
     eso SIEMPRE gana por sobre prefers-color-scheme, en ambas direcciones. */
  :root[data-theme='light'] {
    --qa-bg: #ffffff;
    --qa-bg-elevated: #f6f6f7;
    --qa-fg: #1a1a1a;
    --qa-fg-muted: #5f5f5f;
    --qa-border: #dcdcdc;
    --qa-link: #1d4ed8;
    --qa-pass-bg: #ecfdf3;
    --qa-fail-bg: #fef2f2;
    --qa-skip-bg: #f4f4f5;
    --qa-pending-bg: #fffbeb;
  }

  :root[data-theme='dark'] {
    --qa-bg: #17181c;
    --qa-bg-elevated: #202127;
    --qa-fg: #ececec;
    --qa-fg-muted: #a8a8a8;
    --qa-border: #34353b;
    --qa-link: #7aa6ff;
    --qa-pass-bg: #10281b;
    --qa-fail-bg: #2c1414;
    --qa-skip-bg: #26262a;
    --qa-pending-bg: #2b2110;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--qa-bg);
    color: var(--qa-fg);
    line-height: 1.5;
  }

  a {
    color: var(--qa-link);
  }

  .qa-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .qa-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .qa-topbar h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .qa-meta {
    color: var(--qa-fg-muted);
    font-size: 0.9rem;
  }

  .qa-theme-toggle {
    border: 1px solid var(--qa-border);
    background: var(--qa-bg-elevated);
    color: var(--qa-fg);
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .qa-theme-toggle:hover {
    filter: brightness(1.08);
  }

  {{#if project.branding.isBranded}}
    /* ============================================================
       Branding opcional (logo + paleta de empresa/cliente) — todo este
       bloque solo se emite cuando `project.branding.isBranded` es true (ver
       `partials/header.hbs` y `core/report/reportGenerator.ts`). Sin
       branding configurado (el caso por defecto, y el de sample-project/),
       el `.qa-topbar` de siempre queda exactamente igual que antes de esta
       feature — no se emite ni una línea de este bloque.

       Nota: si se configura SOLO un subconjunto de los 4 colores (p. ej.
       `primaryColor` sin `accentColor`), las declaraciones que dependen de
       un color ausente quedan vacías (`background: ;`) y el navegador las
       descarta silenciosamente — degrada con gracia (sin fondo/franja) en
       vez de romper el resto del CSS, pero el resultado visual completo
       asume que se configuran los 4 colores juntos. */

    /* `!important` deliberado: `--qa-link` (usado por `a { color: ... }`,
       única otra cosa "de acento" del reporte además del header/franja) ya
       está seteado en 4 selectores distintos (`:root` claro/oscuro y sus
       variantes `[data-theme]`/`prefers-color-scheme`, ver arriba en este
       mismo archivo) para soportar el toggle de tema. Igualar o superar la
       especificidad de los 4 a mano sería frágil ante el próximo cambio de
       tema; `!important` en esta única declaración expresa directamente la
       regla real: "si hay un acento de marca configurado, ese acento gana
       siempre, sin importar el tema". */
    :root {
      --qa-link: {{project.branding.accentColor}} !important;
    }

    .qa-brandbar {
      background: {{project.branding.primaryColor}};
      color: {{project.branding.primaryContrast}};
      margin-bottom: 24px;
    }

    .qa-brandbar__inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .qa-brand-logo {
      height: 40px;
      width: auto;
      display: block;
      flex-shrink: 0;
    }

    .qa-brandbar__text {
      flex: 1;
      min-width: 0;
    }

    .qa-brandbar__text h1 {
      font-size: 1.5rem;
      margin: 0;
    }

    .qa-meta--onbrand {
      color: {{project.branding.primaryContrast}};
      opacity: 0.8;
    }

    .qa-theme-toggle--onbrand {
      border-color: color-mix(in srgb, {{project.branding.primaryContrast}} 35%, transparent);
      background: color-mix(in srgb, {{project.branding.primaryContrast}} 12%, transparent);
      color: {{project.branding.primaryContrast}};
    }

    /* La "firma" del branding (ver skill frontend-design): una franja fina
       con los 3 colores vivos de la marca, siempre en el mismo orden —
       reconocible de un vistazo sin necesidad de leer nada. */
    .qa-brand-stripe {
      height: 4px;
      background: linear-gradient(
        90deg,
        {{project.branding.accentColor}},
        {{project.branding.highlightColor}},
        {{project.branding.ctaColor}}
      );
    }
  {{/if}}

  .qa-card {
    background: var(--qa-bg-elevated);
    border: 1px solid var(--qa-border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .qa-dashboard-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
  }

  /* Los SVG del dashboard (donut y barra de progreso, ver core/report/charts.ts)
     tienen width/height fijos como atributos para que sean válidos "sueltos"
     (p. ej. si alguien los abre fuera de este template). Acá se los fuerza a
     escalar dentro de su contenedor usando el viewBox — si no, en pantallas
     angostas la barra de 480px de ancho se sale del .qa-card. */
  .qa-dashboard-grid svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .qa-legend {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .qa-legend li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
  }

  .qa-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
    flex-shrink: 0;
  }

  .qa-swatch--pass {
    background: var(--qa-pass);
  }
  .qa-swatch--fail {
    background: var(--qa-fail);
  }
  .qa-swatch--skip {
    background: var(--qa-skip);
  }
  .qa-swatch--pending {
    background: var(--qa-pending);
  }

  .qa-progress-block {
    flex: 1;
    min-width: 260px;
  }

  .qa-progress-block h3 {
    margin: 0 0 8px;
    font-size: 1rem;
  }

  .qa-table-wrapper {
    overflow-x: auto;
  }

  table.qa-feature-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  table.qa-feature-table th,
  table.qa-feature-table td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--qa-border);
    white-space: nowrap;
  }

  table.qa-feature-table th {
    color: var(--qa-fg-muted);
    font-weight: 600;
  }

  .qa-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
  }

  .qa-badge--pass {
    color: var(--qa-pass);
    background: var(--qa-pass-bg);
    border-color: var(--qa-pass);
  }
  .qa-badge--fail {
    color: var(--qa-fail);
    background: var(--qa-fail-bg);
    border-color: var(--qa-fail);
  }
  .qa-badge--skip {
    color: var(--qa-skip);
    background: var(--qa-skip-bg);
    border-color: var(--qa-skip);
  }
  .qa-badge--pending {
    color: var(--qa-pending);
    background: var(--qa-pending-bg);
    border-color: var(--qa-pending);
  }

  .qa-scenario {
    border: 1px solid var(--qa-border);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 18px;
  }

  .qa-scenario-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .qa-scenario-header h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .qa-tag {
    color: var(--qa-fg-muted);
    font-size: 0.78rem;
  }

  .qa-step {
    border-top: 1px solid var(--qa-border);
    padding: 12px 0;
  }

  .qa-step:first-of-type {
    border-top: none;
  }

  .qa-step-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .qa-step-keyword {
    font-weight: 700;
    color: var(--qa-fg-muted);
  }

  .qa-step-background {
    opacity: 0.75;
    font-style: italic;
  }

  .qa-step-notes {
    margin: 8px 0 0;
    color: var(--qa-fg-muted);
    font-size: 0.9rem;
  }

  .qa-defect {
    margin: 10px 0 0;
    padding: 10px 12px;
    border: 1px solid var(--qa-fail);
    background: var(--qa-fail-bg);
    border-radius: 8px;
    color: var(--qa-fg);
  }

  .qa-defect strong {
    color: var(--qa-fail);
    display: block;
    margin-bottom: 4px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .qa-evidence-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .qa-evidence-item {
    border: 1px solid var(--qa-border);
    border-radius: 8px;
    padding: 6px;
    background: var(--qa-bg-elevated);
    width: 160px;
  }

  .qa-evidence-item img,
  .qa-evidence-item video {
    display: block;
    width: 100%;
    border-radius: 4px;
    background: #000;
  }

  .qa-evidence-filename {
    display: block;
    font-size: 0.72rem;
    color: var(--qa-fg-muted);
    margin-top: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qa-back-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .qa-empty {
    color: var(--qa-fg-muted);
    font-style: italic;
  }
</style>
