<style>
  /* ============================================================
     qa-evidence-reporter — CSS embebido (sin <link> externo, ver
     ARCHITECTURE.md "Reporte HTML": el reporte debe abrir con file://
     sin servidor). Tema claro/oscuro vía prefers-color-scheme + un
     toggle que fuerza el tema y lo persiste en localStorage (ver
     partials/theme-script.hbs).

     Los colores de estado (pass/fail/skip/pending) están hardcodeados
     en hex para que coincidan EXACTAMENTE con los del SVG generado en
     src/core/report/charts.ts (RESULT_COLORS) — si se cambia uno, hay
     que cambiar el otro; no hay una única fuente de verdad compartida
     entre TS y CSS porque el CSS no puede importar un módulo TS.
     ============================================================ */
  :root {
    --qa-bg: #ffffff;
    --qa-bg-elevated: #f6f6f7;
    --qa-fg: #1a1a1a;
    --qa-fg-muted: #5f5f5f;
    --qa-border: #dcdcdc;
    --qa-link: #1d4ed8;

    --qa-pass: #15803d;
    --qa-fail: #b91c1c;
    --qa-skip: #57534e;
    --qa-pending: #b45309;

    --qa-pass-bg: #ecfdf3;
    --qa-fail-bg: #fef2f2;
    --qa-skip-bg: #f4f4f5;
    --qa-pending-bg: #fffbeb;

    /*
     * Variante "sobre tinte" de cada color de estado, para texto/bordes que
     * se apoyan en su propio `-bg` (badges, chips de stat, riel, callout de
     * defecto) — DISTINTA de `--qa-pass`/etc. arriba, que debe seguir
     * calzando EXACTO con `RESULT_COLORS` en `core/report/charts.ts` (ver
     * comentario al principio de este archivo) y por eso no puede variar
     * por tema. En claro, "sobre tinte" es el mismo valor que su base (el
     * 700/800 original ya rinde ≥4.5:1 sobre blanco/gris claro). En oscuro
     * (ver los 3 bloques de abajo) se aclara a un tono que sigue leyéndose
     * como el mismo color, pero cumple contraste sobre superficies oscuras
     * — la base sin aclarar cae tan bajo como 1.98:1 en el chip de
     * "Omitidos" y 2.10–2.48:1 en el riel, medido contra sus propios
     * fondos oscuros.
     */
    --qa-pass-on-tint: var(--qa-pass);
    --qa-fail-on-tint: var(--qa-fail);
    --qa-skip-on-tint: var(--qa-skip);
    --qa-pending-on-tint: var(--qa-pending);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --qa-bg: #17181c;
      --qa-bg-elevated: #202127;
      --qa-fg: #ececec;
      --qa-fg-muted: #a8a8a8;
      --qa-border: #34353b;
      --qa-link: #7aa6ff;

      --qa-pass-bg: #10281b;
      --qa-fail-bg: #2c1414;
      --qa-skip-bg: #26262a;
      --qa-pending-bg: #2b2110;

      --qa-pass-on-tint: #4ade80;
      --qa-fail-on-tint: #f87171;
      --qa-skip-on-tint: #a8a8a8;
      --qa-pending-on-tint: #fbbf24;
    }
  }

  /* El toggle (ver theme-script.hbs) estampa data-theme en <html> y
     eso SIEMPRE gana por sobre prefers-color-scheme, en ambas direcciones. */
  :root[data-theme='light'] {
    --qa-bg: #ffffff;
    --qa-bg-elevated: #f6f6f7;
    --qa-fg: #1a1a1a;
    --qa-fg-muted: #5f5f5f;
    --qa-border: #dcdcdc;
    --qa-link: #1d4ed8;
    --qa-pass-bg: #ecfdf3;
    --qa-fail-bg: #fef2f2;
    --qa-skip-bg: #f4f4f5;
    --qa-pending-bg: #fffbeb;
    --qa-pass-on-tint: var(--qa-pass);
    --qa-fail-on-tint: var(--qa-fail);
    --qa-skip-on-tint: var(--qa-skip);
    --qa-pending-on-tint: var(--qa-pending);
  }

  :root[data-theme='dark'] {
    --qa-bg: #17181c;
    --qa-bg-elevated: #202127;
    --qa-fg: #ececec;
    --qa-fg-muted: #a8a8a8;
    --qa-border: #34353b;
    --qa-link: #7aa6ff;
    --qa-pass-bg: #10281b;
    --qa-fail-bg: #2c1414;
    --qa-skip-bg: #26262a;
    --qa-pending-bg: #2b2110;
    --qa-pass-on-tint: #4ade80;
    --qa-fail-on-tint: #f87171;
    --qa-skip-on-tint: #a8a8a8;
    --qa-pending-on-tint: #fbbf24;
  }

  * {
    box-sizing: border-box;
  }

  /* Oculto visualmente pero disponible para lectores de pantalla — el hero
     del dashboard (ver `.qa-hero`) ya no tiene un <h2> visible, pero la
     sección igual necesita uno accesible. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /*
   * Dos familias, roles distintos (ver skill frontend-design): serif para
   * cualquier NÚMERO que sea el protagonista de su bloque (el % del hero,
   * el % de cada feature) — le da al reporte un aire de "documento/informe
   * formal" en vez de "panel de admin"; sans para todo lo demás (texto,
   * etiquetas, UI). Ambas son pilas de fuentes del sistema — CERO fuentes
   * externas/embebidas, el reporte sigue abriendo offline sin depender de
   * que la fuente exista en el archivo (ver ARCHITECTURE.md, "Reporte
   * HTML").
   */
  :root {
    --qa-font-body: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --qa-font-display: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman',
      serif;
  }

  body {
    margin: 0;
    font-family: var(--qa-font-body);
    background: var(--qa-bg);
    color: var(--qa-fg);
    line-height: 1.5;
  }

  a {
    color: var(--qa-link);
  }

  /* Foco de teclado visible en todo elemento interactivo — antes de esta
     pasada no había ningún `:focus-visible` propio, así que dependía
     enteramente del outline por defecto del navegador sobre fondos de
     tarjeta/tema oscuro propios, sin verificar. `:focus-visible` (no
     `:focus`) para no mostrar el anillo en un click de mouse, solo en
     navegación por teclado. */
  a:focus-visible,
  button:focus-visible,
  video:focus-visible {
    outline: 2px solid var(--qa-link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Skip-link (ver partials/header.hbs, primer elemento del <body> en
     ambas páginas): oculto fuera de pantalla hasta que recibe foco por
     teclado, momento en el que se vuelve visible arriba a la izquierda —
     deja saltar directo a `#qa-main` sin tabular por el header/logo/toggle
     de tema en cada página. */
  .qa-skip-link {
    position: absolute;
    top: -100%;
    left: 12px;
    z-index: 10;
    padding: 10px 16px;
    background: var(--qa-link);
    color: #ffffff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .qa-skip-link:focus-visible {
    top: 12px;
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /* Ícono de trazo único compartido por todos los SVG inline del reporte
     (chevrons, toggle de tema, alerta de defecto — ver partials/theme-icon.hbs,
     chevron-right.hbs, chevron-left.hbs, icon-alert.hbs). `currentColor`
     hace que cada uno herede el color de texto de quien lo incluya, así
     este archivo no necesita una regla de color por ícono. */
  .qa-icon {
    display: inline-block;
    vertical-align: -2px;
    flex-shrink: 0;
  }

  .qa-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px 80px;
  }

  .qa-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  /* Sin eyebrow arriba del título (ver header.hbs): el <h1> es lo primero
     que se lee en la página, así que lleva el peso completo de la
     jerarquía — de ahí la escala más grande que un título de sección
     cualquiera. Clase compartida entre las dos variantes de header (ver
     header.hbs) en vez de un selector compuesto que nombre la variante de
     marca: un test de integración verifica que, sin branding configurado,
     el HTML generado no contenga ni el nombre de esa clase — así que
     ninguna regla fuera del bloque condicional de branding, ni sus
     comentarios, puede mencionarla. */
  .qa-page-title {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.05rem);
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .qa-meta {
    margin: 8px 0 0;
    color: var(--qa-fg-muted);
    font-size: 0.92rem;
  }

  .qa-theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--qa-border);
    background: var(--qa-bg-elevated);
    color: var(--qa-fg);
    border-radius: 8px;
    padding: 8px 15px;
    cursor: pointer;
    font-size: 0.88rem;
    font-family: inherit;
  }

  .qa-theme-toggle:hover {
    filter: brightness(1.08);
  }

  {{#if project.branding.isBranded}}
    /* ============================================================
       Branding opcional (logo + paleta de empresa/cliente) — todo este
       bloque solo se emite cuando `project.branding.isBranded` es true (ver
       `partials/header.hbs` y `core/report/reportGenerator.ts`). Sin
       branding configurado (el caso por defecto, y el de sample-project/),
       el `.qa-topbar` de siempre queda exactamente igual que antes de esta
       feature — no se emite ni una línea de este bloque.

       Nota: si se configura SOLO un subconjunto de los 4 colores (p. ej.
       `primaryColor` sin `accentColor`), las declaraciones que dependen de
       un color ausente quedan vacías (`background: ;`) y el navegador las
       descarta silenciosamente — degrada con gracia (sin fondo/franja) en
       vez de romper el resto del CSS, pero el resultado visual completo
       asume que se configuran los 4 colores juntos. */

    /* `!important` deliberado: `--qa-link` (usado por `a { color: ... }`,
       única otra cosa "de acento" del reporte además del header/franja) ya
       está seteado en 4 selectores distintos (`:root` claro/oscuro y sus
       variantes `[data-theme]`/`prefers-color-scheme`, ver arriba en este
       mismo archivo) para soportar el toggle de tema. Igualar o superar la
       especificidad de los 4 a mano sería frágil ante el próximo cambio de
       tema; `!important` en esta única declaración expresa directamente la
       regla real: "si hay un acento de marca configurado, ese acento gana
       siempre, sin importar el tema". */
    :root {
      --qa-link: {{project.branding.accentColor}} !important;
    }

    .qa-brandbar {
      background: {{project.branding.primaryColor}};
      color: {{project.branding.primaryContrast}};
      margin-bottom: 28px;
    }

    .qa-brandbar__inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 20px;
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .qa-brand-logo {
      height: 40px;
      width: auto;
      display: block;
      flex-shrink: 0;
    }

    .qa-brandbar__text {
      flex: 1;
      min-width: 0;
    }

    .qa-meta--onbrand {
      color: {{project.branding.primaryContrast}};
      opacity: 0.8;
    }

    .qa-theme-toggle--onbrand {
      border-color: color-mix(in srgb, {{project.branding.primaryContrast}} 35%, transparent);
      background: color-mix(in srgb, {{project.branding.primaryContrast}} 12%, transparent);
      color: {{project.branding.primaryContrast}};
    }

    /* La "firma" del branding (ver skill frontend-design): una franja fina
       con los 3 colores vivos de la marca, siempre en el mismo orden —
       reconocible de un vistazo sin necesidad de leer nada. */
    .qa-brand-stripe {
      height: 5px;
      background: linear-gradient(
        90deg,
        {{project.branding.accentColor}},
        {{project.branding.highlightColor}},
        {{project.branding.ctaColor}}
      );
    }
  {{/if}}

  .qa-card {
    background: var(--qa-bg-elevated);
    border: 1px solid var(--qa-border);
    border-radius: 14px;
    padding: 28px;
    margin-bottom: 32px;
  }

  .qa-section-heading {
    margin: 0 0 24px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.005em;
  }

  /* Aclaración breve en lenguaje llano (Gherkin, Omitido vs. Pendiente) —
     nunca un eyebrow arriba de un heading (ver Do's and Don'ts), siempre
     texto de cuerpo secundario en su lugar natural: bajo el heading de
     sección, o bajo los chips de stat. */
  .qa-hint {
    margin: 0 0 16px;
    font-size: 0.82rem;
    color: var(--qa-fg-muted);
    line-height: 1.5;
  }

  /* Dentro de `.qa-hero__side` el espaciado ya lo da el `gap` del flex
     container (ver más abajo) — un margin propio acá lo duplicaría. */
  .qa-hero__side .qa-hint {
    margin: 0;
  }

  /*
   * El "hero": el % de aprobación es el protagonista de todo el reporte —
   * lo primero que se lee, en la tipografía serif (ver `--qa-font-display`
   * arriba). El donut queda como visual de acompañamiento — y, con datos
   * reales, ya no repite el mismo número en su centro (ver
   * `renderDonutChart(summary, { showCenterLabel: ... })` en
   * `reportGenerator.ts`): duplicar el % dos veces a centímetros de
   * distancia no sumaba jerarquía, competía con ella.
   */
  .qa-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 44px;
  }

  .qa-hero__stat {
    flex-shrink: 0;
  }

  .qa-hero__number {
    margin: 0;
    font-family: var(--qa-font-display);
    font-size: clamp(3.25rem, 2.4rem + 4.2vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .qa-hero__number span {
    font-size: clamp(1.75rem, 1.4rem + 1.8vw, 2.5rem);
    font-weight: 500;
    opacity: 0.7;
  }

  .qa-hero__caption {
    margin: 10px 0 0;
    color: var(--qa-fg-muted);
    font-size: 0.95rem;
    max-width: 28ch;
  }

  /* Salta directo al primer scenario fallido (ver `firstFailureHref`/
     `firstFailedScenarioId` en reportGenerator.ts) en vez de depender solo
     de scroll + rail-scanning — no aparece si no hay ningún fallo. */
  .qa-jump-to-failure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--qa-fail-on-tint);
    background: var(--qa-fail-bg);
    color: var(--qa-fail-on-tint);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .qa-jump-to-failure:hover {
    filter: brightness(1.05);
  }

  .qa-hero__chart {
    flex-shrink: 0;
  }

  /* Mount points de ECharts (ver partials/dashboard-charts-script.hbs) — el
     gauge es ahora el protagonista tipográfico (lleva el % en su centro, en
     Display font, calculado en JS con la misma fórmula clamp() que
     `.qa-hero__number` de feature-detail.hbs) así que es más grande que el
     doughnut, que queda como visual de acompañamiento. Tamaño fijo en px
     (no `clamp()`): ECharts necesita dimensiones concretas al inicializar
     el canvas, y `chart.resize()` (ver el script) ya lo mantiene correcto
     ante cambios de viewport. */
  .qa-hero__gauge {
    width: 260px;
    height: 260px;
    max-width: 100%;
    flex-shrink: 0;
  }

  .qa-hero__doughnut {
    width: 200px;
    height: 200px;
    max-width: 100%;
    flex-shrink: 0;
  }

  .qa-hero__side {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Distribución de resultados como chips tono-sobre-tono (ver
     partials/legend.hbs) — mismo lenguaje visual que `.qa-badge`, pero como
     mini tarjetas con el conteo real de protagonista en vez de una lista de
     punto+texto. */
  .qa-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .qa-stat {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
  }

  .qa-stat__count {
    font-family: var(--qa-font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
  }

  .qa-stat__label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .qa-stat__percent {
    font-size: 0.72rem;
    font-weight: 500;
  }

  .qa-stat--pass {
    background: var(--qa-pass-bg);
    color: var(--qa-pass-on-tint);
    border-color: color-mix(in srgb, var(--qa-pass-on-tint) 28%, transparent);
  }
  .qa-stat--fail {
    background: var(--qa-fail-bg);
    color: var(--qa-fail-on-tint);
    border-color: color-mix(in srgb, var(--qa-fail-on-tint) 28%, transparent);
  }
  .qa-stat--skip {
    background: var(--qa-skip-bg);
    color: var(--qa-skip-on-tint);
    border-color: color-mix(in srgb, var(--qa-skip-on-tint) 28%, transparent);
  }
  .qa-stat--pending {
    background: var(--qa-pending-bg);
    color: var(--qa-pending-on-tint);
    border-color: color-mix(in srgb, var(--qa-pending-on-tint) 28%, transparent);
  }

  .qa-progress-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.85rem;
    color: var(--qa-fg-muted);
    margin-bottom: 8px;
  }

  .qa-progress-label strong {
    color: var(--qa-fg);
    font-family: var(--qa-font-display);
    font-size: 1.05rem;
  }

  /* Reemplaza el SVG generado server-side que tenía esta barra antes de
     integrar ECharts (ver historial de `renderProgressBar` en
     core/report/charts.ts) — un div con `width` inline alcanza para una
     barra plana de un solo valor, no justifica una librería de charting.
     Verde fijo (`--qa-pass`): ver DESIGN.md, "La Regla del Cuarto Color" —
     completar la sesión es conceptualmente lo mismo que aprobar. */
  .qa-progress-track {
    height: 14px;
    border-radius: 999px;
    background: var(--qa-border);
    overflow: hidden;
  }

  .qa-progress-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--qa-pass);
  }

  /* Mount point de la barra apilada "Estado por feature" (ver
     partials/dashboard-charts-script.hbs, sección condicional a ≥3
     features) — el alto real lo fija el script en línea, proporcional a
     la cantidad de features; este mínimo es solo para que el layout no
     salte de 0 a su alto final durante la carga. */
  .qa-chart-feature-bars {
    width: 100%;
    min-height: 180px;
  }

  /* Mount point del sunburst jerárquico (ver misma nota de diseño arriba,
     condicional a ≥3 features con ≥2 scenarios cada una) — cuadrado,
     centrado, con un tope de ancho para que no domine toda la tarjeta en
     pantallas grandes. */
  .qa-chart-sunburst {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .qa-feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .qa-feature-list li + li {
    border-top: 1px solid var(--qa-border);
  }

  .qa-feature-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 18px;
    row-gap: 8px;
    padding: 18px;
    margin: 0 -18px;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    transition: background-color 0.12s ease;
  }

  .qa-feature-row:hover {
    background: var(--qa-bg);
  }

  .qa-feature-row__main {
    flex: 1 1 220px;
    min-width: 0;
  }

  .qa-feature-row__name {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .qa-feature-row__tags {
    margin: 4px 0 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  /* Micro-barra de progreso por feature (ver partials/feature-progress-bar.hbs)
     — mismo lenguaje de color que el resto del sistema (hex fijo de
     RESULT_COLORS, igual que los charts de ECharts: es un indicador visual
     de proporción, no texto/borde propio, así que no necesita la variante
     on-tint que exige DESIGN.md para esos dos casos). */
  .qa-feature-row__bar {
    margin: 10px 0 0;
    display: flex;
    height: 6px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--qa-border);
  }

  .qa-feature-row__bar-segment {
    display: block;
    height: 100%;
  }

  .qa-feature-row__bar-segment--pass {
    background: var(--qa-pass);
  }
  .qa-feature-row__bar-segment--fail {
    background: var(--qa-fail);
  }
  .qa-feature-row__bar-segment--skip {
    background: var(--qa-skip);
  }
  .qa-feature-row__bar-segment--pending {
    background: var(--qa-pending);
  }

  .qa-feature-row__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .qa-feature-row__meta .qa-icon {
    color: var(--qa-fg-muted);
  }

  .qa-feature-row__count {
    color: var(--qa-fg-muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .qa-feature-row__percent {
    font-family: var(--qa-font-display);
    font-size: 1.55rem;
    font-weight: 600;
    min-width: 3.4ch;
    text-align: right;
  }

  .qa-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    white-space: nowrap;
