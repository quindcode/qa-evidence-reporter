  .qa-feature-row.qa-rail--pass:hover {
    box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--qa-pass-on-tint) 35%, transparent);
  }
  .qa-feature-row.qa-rail--fail:hover {
