<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{feature.name}} — {{project.projectName}}</title>
    {{> theme-init}}
    {{> styles}}
  </head>
  <body>
    {{#> header heading=feature.name}}
      {{project.projectName}}
      {{#if feature.tags.length}} · {{#each feature.tags}}<span class="qa-tag">#{{this}}</span> {{/each}}{{/if}}
    {{/header}}

    <main class="qa-container" id="qa-main">
      <a class="qa-back-link" href="{{basePath}}index.html">{{> chevron-left}} Volver al dashboard</a>

      <section class="qa-card qa-rail qa-rail--{{feature.result}}">
        <div class="qa-hero">
          <div class="qa-hero__stat">
            {{> badge feature}}
            <p class="qa-hero__number">{{feature.summary.passRatePercent}}<span>%</span></p>
            <p class="qa-hero__caption">
              {{feature.summary.pass}}/{{feature.summary.total}} scenarios aprobados
            </p>
            {{#if feature.firstFailedScenarioId}}
              <button
                type="button"
                class="qa-jump-to-failure"
                data-jump-to-first-failure
                data-target-scenario-id="scenario-{{feature.firstFailedScenarioId}}"
              >
                {{> icon-alert}} Ver primer fallo
              </button>
            {{/if}}
          </div>
          <div class="qa-hero__side">{{> legend summary=feature.summary}}</div>
        </div>
      </section>

      <h2 class="qa-section-heading">Escenarios</h2>
      <p class="qa-hint">Cada paso sigue el formato Gherkin: <strong>Given</strong> (condición inicial), <strong>When</strong> (acción) y <strong>Then</strong> (resultado esperado). Hacé clic en un scenario o en un step para ver su detalle.</p>

      {{#each feature.scenarios}}
        <section
          class="qa-scenario qa-rail qa-rail--{{result}}"
          id="scenario-{{id}}"
          data-scenario
          data-result="{{result}}"
        >
          <button
            type="button"
            class="qa-scenario-header"
            aria-expanded="{{scenarioDefaultOpen result @root.feature.result @first}}"
            aria-controls="scenario-body-{{id}}"
            data-scenario-toggle
          >
            {{> chevron-right}}
            <h3>{{name}}</h3>
            {{> badge}}
            {{#if tags.length}}
              {{#each tags}}<span class="qa-tag">#{{this}}</span> {{/each}}
            {{/if}}
          </button>

          <div
            class="qa-scenario-body"
            id="scenario-body-{{id}}"
            data-scenario-body
            style="max-height: {{#if (scenarioDefaultOpen result @root.feature.result @first)}}none{{else}}0px{{/if}};"
          >
            <div class="qa-scenario-body__inner">
              {{#each steps}}
                <div class="qa-step" id="step-{{id}}" data-step data-result="{{result}}">
                  <button
                    type="button"
                    class="qa-step-header"
                    aria-expanded="false"
                    aria-controls="step-body-{{id}}"
                    data-step-toggle
                  >
                    {{> chevron-right}}
                    <span class="qa-step-keyword {{#if fromBackground}}qa-step-background{{/if}}">{{keyword}}</span>
                    <span class="qa-step-text">{{text}}</span>
                    {{> badge}}
                  </button>

                  <div class="qa-step-body" id="step-body-{{id}}" data-step-body style="max-height: 0px;">
                    <div class="qa-step-body__inner">
                      {{#if notes}}
                        <p class="qa-step-notes">📝 {{notes}}</p>
                      {{/if}}

                      {{#if (eq result "fail")}}
                        <div class="qa-defect">
                          <strong>{{> icon-alert}} Defecto encontrado</strong>
                          {{defectDescription}}
                        </div>
                      {{/if}}

                      {{#if evidence.length}}
                        <div class="qa-evidence-grid">
                          {{#each evidence}}
                            {{> evidence-item}}
                          {{/each}}
                        </div>
                      {{/if}}

                      {{#unless notes}}
                        {{#unless (eq result "fail")}}
                          {{#unless evidence.length}}
                            <p class="qa-empty">Sin notas, defecto ni evidencia para este step.</p>
                          {{/unless}}
                        {{/unless}}
                      {{/unless}}
                    </div>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </section>
      {{/each}}
    </main>
    {{> accordion-script}}
    {{> theme-toggle-script}}
  </body>
</html>
