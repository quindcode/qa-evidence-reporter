<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{feature.name}} — {{project.projectName}}</title>
    {{> theme-init}}
    {{> styles}}
  </head>
  <body>
    {{#> header heading=feature.name}}
      {{project.projectName}}
      {{#if feature.tags.length}} · {{#each feature.tags}}<span class="qa-tag">#{{this}}</span> {{/each}}{{/if}}
    {{/header}}

    <div class="qa-container">
      <a class="qa-back-link" href="{{basePath}}index.html">&larr; Volver al dashboard</a>

      <section class="qa-card qa-rail qa-rail--{{feature.result}}">
        <div class="qa-hero">
          <div class="qa-hero__stat">
            {{> badge feature}}
            <p class="qa-hero__number">{{feature.summary.passRatePercent}}<span>%</span></p>
            <p class="qa-hero__caption">
              {{feature.summary.pass}}/{{feature.summary.total}} steps aprobados
            </p>
          </div>
          <div class="qa-hero__side">{{> legend summary=feature.summary}}</div>
        </div>
      </section>

      <h2 class="qa-section-heading">Escenarios</h2>

      {{#each feature.scenarios}}
        <section class="qa-scenario qa-rail qa-rail--{{result}}" aria-label="Scenario: {{name}}">
          <div class="qa-scenario-header">
            <h3>{{name}}</h3>
            {{> badge}}
            {{#if tags.length}}
              {{#each tags}}<span class="qa-tag">#{{this}}</span> {{/each}}
            {{/if}}
          </div>

          {{#each steps}}
            <div class="qa-step">
              <div class="qa-step-header">
                <span class="qa-step-keyword {{#if fromBackground}}qa-step-background{{/if}}">{{keyword}}</span>
                <span>{{text}}</span>
                {{> badge}}
              </div>

              {{#if notes}}
                <p class="qa-step-notes">📝 {{notes}}</p>
              {{/if}}

              {{#if (eq result "fail")}}
                <div class="qa-defect" role="alert">
                  <strong>Defecto encontrado</strong>
                  {{defectDescription}}
                </div>
              {{/if}}

              {{#if evidence.length}}
                <div class="qa-evidence-grid">
                  {{#each evidence}}
                    {{> evidence-item}}
                  {{/each}}
                </div>
              {{/if}}
            </div>
          {{/each}}
        </section>
      {{/each}}
    </div>
    {{> theme-toggle-script}}
  </body>
</html>
